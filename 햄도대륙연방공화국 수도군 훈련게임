<!DOCTYPE html>
<html lang="ko"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>총 게임</title>
<style>
html,body{margin:0;height:100%;overflow:hidden;background:#fff;touch-action:none;user-select:none;font-family:sans-serif}
canvas{display:block}
.b{position:fixed;width:64px;height:64px;border-radius:50%;background:rgba(0,0,0,.35);color:#fff;font-size:24px;display:flex;align-items:center;justify-content:center}
#fire{right:24px;bottom:40px;width:96px;height:96px;background:rgba(220,0,0,.6);font-size:36px}
#reload{right:140px;bottom:24px}
#cross{position:fixed;left:50%;top:50%;width:12px;height:12px;margin:-6px;border:2px solid #f00;border-radius:50%}
#hud{position:fixed;left:12px;top:10px;font-size:18px;color:#000}
#up{left:76px;bottom:116px}#dn{left:76px;bottom:20px}#lf{left:12px;bottom:68px}#rt{left:140px;bottom:68px}
</style></head><body>
<div id="hud"></div><div id="cross"></div>
<div class="b" id="up">▲</div><div class="b" id="dn">▼</div><div class="b" id="lf">◀</div><div class="b" id="rt">▶</div>
<div class="b" id="reload">R</div><div class="b" id="fire">🔫</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const scene=new THREE.Scene();scene.background=new THREE.Color(0xffffff);
const cam=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,.05,200);
const ren=new THREE.WebGLRenderer({antialias:true});ren.setSize(innerWidth,innerHeight);document.body.appendChild(ren.domElement);
addEventListener('resize',()=>{ren.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix()});
const black=new THREE.MeshBasicMaterial({color:0});
const floor=new THREE.Mesh(new THREE.BoxGeometry(60,1,60),new THREE.MeshBasicMaterial({color:0x808080}));
floor.position.y=-.5;scene.add(floor);
// 목표물(검정 블록)
const targets=[],walls=[];
const wmat=new THREE.MeshBasicMaterial({color:0x8b5a2b}); // 벽 모델 2x13x11
function addWalls(){for(let i=0;i<5;i++){const w=new THREE.Mesh(new THREE.BoxGeometry(2,13,11),wmat);
 w.scale.setScalar(1/6);w.rotation.y=Math.PI/2; // 폭이 좌우로 가게
 w.position.set((Math.random()-.5)*30,13/12,-4-Math.random()*14);scene.add(w);walls.push(w)}}
const ttex=new THREE.TextureLoader().load("data:image/png;base64,");
ttex.magFilter=THREE.NearestFilter;ttex.minFilter=THREE.NearestFilter;
const tmat=new THREE.MeshBasicMaterial({map:ttex,transparent:true,alphaTest:.1});
function spawn(){for(let i=0;i<8;i++){ // 과녁 모델 9x13x2, 텍스처 32x32
 const g=new THREE.BoxGeometry(9,13,2);boxUV(g,{size:[9,13,2],uv:[0,0],T:32});
 const m=new THREE.Mesh(g,tmat);m.scale.setScalar(1/8);m.rotation.y=Math.PI; // 과녁 앞면이 플레이어를 향함
 m.position.set((Math.random()-.5)*40,13/16,-6-Math.random()*22);scene.add(m);targets.push(m)}}
// 총 모델 (카메라에 붙임)
const gun=new THREE.Group();
const GEO=[{"name": "bone", "pivot": [0, 0, 0], "cubes": [{"origin": [-2, 0, -1], "size": [2, 2, 8], "pivot": [-1, 0, 0], "rotation": [0, -17.5, 0], "uv": [0, 11]}]}, {"name": "bone2", "parent": "bone", "pivot": [0, 0, 0], "cubes": [{"origin": [-5, 0, -1], "size": [2, 2, 9], "pivot": [-4, 0, 0], "rotation": [0, 5, 0], "uv": [0, 0]}]}, {"name": "bone3", "pivot": [-1, 0, 0], "cubes": [{"origin": [-3, 0, 5], "size": [1, 5, 2], "uv": [20, 20]}]}, {"name": "bone4", "pivot": [0, 0, 0], "cubes": [{"origin": [-3, 3, 6], "size": [1, 2, 7], "uv": [20, 11]}]}, {"name": "bone5", "pivot": [-1, 0, 0], "locators": {"_null_null_object": [-2, 0, 0]}}];
const tex=new THREE.TextureLoader().load("data:image/png;base64,");
tex.magFilter=THREE.NearestFilter;tex.minFilter=THREE.NearestFilter;
const hand=new THREE.Group();
function boxUV(g,c){const[w,h,d]=c.size,[u,v]=c.uv,T=c.T||64,uv=g.attributes.uv;
 const R=[[u+d+w,v+d,d,h],[u,v+d,d,h],[u+d,v,w,d],[u+d+w,v,w,d],[u+d+w+d,v+d,w,h],[u+d,v+d,w,h]]; // +x,-x,+y,-y,+z,-z
 R.forEach((r,i)=>{const x0=r[0]/T,x1=(r[0]+r[2])/T,y0=1-r[1]/T,y1=1-(r[1]+r[3])/T;
  uv.setXY(i*4,x0,y0);uv.setXY(i*4+1,x1,y0);uv.setXY(i*4+2,x0,y1);uv.setXY(i*4+3,x1,y1)})}
GEO.forEach(b=>(b.cubes||[]).forEach(c=>{
 const geo=new THREE.BoxGeometry(c.size[0],c.size[1],c.size[2]);boxUV(geo,c);
 const m=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({map:tex,transparent:true,alphaTest:.1}));
 const p=c.pivot||[c.origin[0]+c.size[0]/2,c.origin[1]+c.size[1]/2,c.origin[2]+c.size[2]/2];
 const pv=new THREE.Group();pv.position.set(p[0],p[1],p[2]);
 if(c.rotation)pv.rotation.set(THREE.MathUtils.degToRad(c.rotation[0]),THREE.MathUtils.degToRad(c.rotation[1]),THREE.MathUtils.degToRad(c.rotation[2]));
 m.position.set(c.origin[0]+c.size[0]/2-p[0],c.origin[1]+c.size[1]/2-p[1],c.origin[2]+c.size[2]/2-p[2]);
 pv.add(m);hand.add(pv)}));
hand.scale.setScalar(1/16);
const wrap=new THREE.Group();wrap.rotation.y=Math.PI;wrap.position.set(-.16,-.28,.15); // 모델 +z가 앞이 되도록 뒤집음
wrap.add(hand);gun.add(wrap);
const flash=new THREE.Mesh(new THREE.SphereGeometry(.06),new THREE.MeshBasicMaterial({color:0xffa000}));
flash.position.set(0,-.2,-.75);flash.visible=false;gun.add(flash);
const gunBase=new THREE.Vector3(0,-.2,-.5);gun.position.copy(gunBase);cam.add(gun);scene.add(cam);
// 상태
let yaw=0,pitch=0,recoil=0,recKick=0,ammo=17,reloading=0,score=0,lastShot=0;
const keys={};const ray=new THREE.Raycaster();
const SHOT="data:audio/mpeg;base64,";
const shotPool=[0,1,2,3].map(()=>new Audio(SHOT));let shotI=0;
function playShot(){try{const a=shotPool[shotI++%shotPool.length];a.currentTime=0;a.play().catch(()=>{})}catch(e){}}
function fire(){
 const t=performance.now();if(t-lastShot<130||reloading)return;
 if(ammo<=0){reload();return}
 lastShot=t;ammo--;recoil=1;playShot();
 pitch+=0.03+Math.random()*0.015;yaw+=(Math.random()-.5)*0.02; // 반동: 시점이 위로 튐
 flash.visible=true;setTimeout(()=>flash.visible=false,50);
 ray.setFromCamera({x:0,y:0},cam);
 const hit=ray.intersectObjects(targets.concat(walls))[0];
 if(hit&&targets.includes(hit.object)){scene.remove(hit.object);targets.splice(targets.indexOf(hit.object),1);score++;if(!targets.length)spawn()}
 else score-=2; // 과녁을 못 맞히면(벽에 맞아도) -2
}
function reload(){if(reloading||ammo===17)return;reloading=90}
// 입력
addEventListener('keydown',e=>{keys[e.code]=1;if(e.code==='Space')fire();if(e.code==='KeyR')reload()});
addEventListener('keyup',e=>keys[e.code]=0);
addEventListener('mousedown',e=>{if(e.target.tagName==='CANVAS')fire()});
function hold(id,k){const el=document.getElementById(id);
 const on=e=>{e.preventDefault();keys[k]=1},off=e=>{e.preventDefault();keys[k]=0};
 el.addEventListener('touchstart',on,{passive:false});el.addEventListener('touchend',off);el.addEventListener('touchcancel',off);
 el.addEventListener('mousedown',on);el.addEventListener('mouseup',off)}
hold('up','KeyW');hold('dn','KeyS');hold('lf','KeyA');hold('rt','KeyD');
const fb=document.getElementById('fire');let fh=0;
fb.addEventListener('touchstart',e=>{e.preventDefault();fh=1},{passive:false});
fb.addEventListener('touchend',()=>fh=0);fb.addEventListener('touchcancel',()=>fh=0);
fb.addEventListener('mousedown',()=>fh=1);fb.addEventListener('mouseup',()=>fh=0);
document.getElementById('reload').addEventListener('touchstart',e=>{e.preventDefault();reload()},{passive:false});
document.getElementById('reload').addEventListener('click',reload);
// 화면 드래그로 시점 이동
let lt=null;
ren.domElement.addEventListener('touchstart',e=>{lt=e.touches[0]});
ren.domElement.addEventListener('touchmove',e=>{const t=e.touches[0];if(lt){yaw-=(t.clientX-lt.clientX)*.005;pitch-=(t.clientY-lt.clientY)*.005}lt=t;
 pitch=Math.max(-1.4,Math.min(1.4,pitch))});
ren.domElement.addEventListener('touchend',()=>lt=null);
// 루프
const hud=document.getElementById('hud');
function loop(){
 requestAnimationFrame(loop);
 if(fh)fire();
 const sp=.12;
 const f=(keys.KeyW?1:0)-(keys.KeyS?1:0),s=(keys.KeyD?1:0)-(keys.KeyA?1:0);
 cam.position.x+=(-Math.sin(yaw)*f+Math.cos(yaw)*s)*sp;
 cam.position.z+=(-Math.cos(yaw)*f-Math.sin(yaw)*s)*sp;
 cam.position.y=1.6;
 pitch=Math.max(-1.4,Math.min(1.4,pitch*.97)); // 반동 후 서서히 복귀
 cam.rotation.set(pitch,yaw,0,'YXZ');
 // 총 반동 애니메이션
 recoil*=.82;
 gun.position.set(gunBase.x,gunBase.y+recoil*.02,gunBase.z+recoil*.14);
 gun.rotation.x=recoil*.35;
 if(reloading){reloading--;gun.rotation.x=.6;if(!reloading)ammo=17}
 hud.textContent=reloading?'장전 중...':`탄 ${ammo}/17  점수 ${score}`;
 ren.render(scene,cam);
}
addWalls();spawn();loop();
</script></body></html>

